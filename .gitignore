# Dependencies
node_modules/

# Build output
dist/
.output/
.nitro/
.tanstack/
.vite/

# Env & secrets — never commit these
.env
.env.*
!.env.example

# Server data store. Holds scrypt password hashes and live session ids, so
# committing it would publish credentials and hand over valid sessions.
data/

# Logs
npm-debug.log*
yarn-error.log*
*.log

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp
